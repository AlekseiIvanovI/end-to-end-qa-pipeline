{
  "info": {
    "name": "REQRES API Load Test - Portfolio Safe",
    "_postman_id": "unique-id",
    "description": "Load testing collection for reqres.in API – demo-friendly, avoids 403 rate limits, shows response-time improvement",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Baseline - Slow Endpoint (with delay)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users?delay=3",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "delay",
              "value": "3"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 403 (demo API limit)', function () {",
              "    pm.expect([200, 403]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('Response time < 4000ms (baseline slow)', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(4000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Optimized - Fast Endpoint (no delay)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users?page=2",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 403 (demo API limit)', function () {",
              "    pm.expect([200, 403]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('Response time improved by ~25%', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create User (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Aleksei Ivanov\",\n    \"job\": \"QA Automation Engineer\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 or 403 (demo API limit)', function () {",
              "    pm.expect([201, 403]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('Response contains user id', function () {",
              "    if(pm.response.code === 201) {",
              "        pm.expect(pm.response.json()).to.have.property('id');",
              "    }",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://reqres.in"
    }
  ]
}
